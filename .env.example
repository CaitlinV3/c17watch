# Copy to .env and `set -a; source .env; set +a` before running. .env is git-ignored.

# Notifications (ntfy)
NTFY_TOPIC=c17-replace-with-a-long-random-string
# NTFY_TOKEN=            # only for a self-hosted / access-controlled ntfy server

# Notifications (Pushover)
# PUSHOVER_APP_TOKEN=
# PUSHOVER_USER_KEY=

# Only for provider = "adsbexchange"
# ADSBX_RAPIDAPI_KEY=
# ADSBX_MONTHLY_QUOTA=10000

# Optional: keep your location out of config.toml
# C17WATCH_LAT=
# C17WATCH_LON=
